# PostgreSQL (docker compose up -d ให้ค่านี้ใช้ได้ทันที)
# บน Render: ใช้ Internal Database URL ของ Render Postgres (หรือ Supabase Postgres)
DATABASE_URL="postgresql://library:library@localhost:5432/library?schema=public"

# Redis (queue สำหรับ reading events + jobs เบื้องหลัง)
# ใช้เฉพาะ /api/track (สถิติการอ่าน EPUB) — ไม่ตั้งก็เปิดเว็บได้ แต่สถิติจะไม่ถูกบันทึก
REDIS_URL="redis://localhost:6379"

# Admin login แบบชั่วคราว (เปลี่ยนเป็น Auth.js ภายหลัง)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# Supabase Storage (ที่เก็บไฟล์หนังสือ/รูปปก) — ดู apps/web/lib/storage.ts
# ตั้งครบ 2 ค่า → อัปโหลดขึ้น Supabase (จำเป็นบน Render)
# ไม่ตั้ง → เขียนลง apps/web/public/uploads (ใช้ได้เฉพาะตอนพัฒนาในเครื่อง)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
# SUPABASE_BUCKET="library-files"

STORAGE_DRIVER="local"