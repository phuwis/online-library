# PostgreSQL (docker compose up -d ให้ค่านี้ใช้ได้ทันที)
DATABASE_URL="postgresql://library:library@localhost:5432/library?schema=public"

# Redis (queue สำหรับ reading events + jobs เบื้องหลัง)
REDIS_URL="redis://localhost:6379"

# Admin login แบบชั่วคราว (เปลี่ยนเป็น Auth.js ภายหลัง)
ADMIN_PASSWORD="change-me"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
