generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────── ข้อมูลหลัก (โตช้า) ─────────────

model Book {
  id                 String       @id @default(cuid()) // สำหรับใช้อ้างอิงภายในระบบ / Relational
  bookCode           String       @unique              // รหัสหนังสือรูปแบบ ddc-YYYYMMDD-XXXXX (Auto-gen)
  slug               String       @unique              // URL Slug สุ่มอัตโนมัติ (UUID/Random, ห้ามแก้ไข)
  
  title              String
  author             String
  description        String?                            // รายละเอียดหนังสือ (รองรับ Markdown ในอนาคต)
  
  coverUrl           String?
  fileUrl            String       
  fileType           FileType     @default(EPUB)
  
  publisher          String?      
  publicationInfo    String?      
  pageCount          String?      
  publishingProvince String?      
  ddc                DdcCategory  @default(GENERAL_000) 

  status             BookStatus   @default(DRAFT)
  publishedAt        DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  categories         BookCategory[]
  progress           ReadingProgress[]
  dailyStats         BookStatsDaily[]

  @@index([status, createdAt])
  @@index([ddc])
  @@index([bookCode])
  @@index([slug])
}

// หมวดหมู่สากล DDC (Dewey Decimal Classification - 10 หมวดหมู่หลัก)
enum DdcCategory {
  GENERAL_000           // 000 - เบ็ดเตล็ด / ความรู้ทั่วไป
  PHILOSOPHY_100        // 100 - ปรัชญาและจิตวิทยา
  RELIGION_200          // 200 - ศาสนา
  SOCIAL_SCIENCES_300   // 300 - สังคมศาสตร์
  LANGUAGE_400          // 400 - ภาษาศาสตร์
  SCIENCE_500           // 500 - วิทยาศาสตร์และคณิตศาสตร์
  TECHNOLOGY_600        // 600 - เทคโนโลยี / วิทยาศาสตร์ประยุกต์
  ARTS_RECREATION_700   // 700 - ศิลปะและการบันเทิง / กีฬา
  LITERATURE_800        // 800 - วรรณกรรม / วรรณคดี
  HISTORY_GEOGRAPHY_900 // 900 - ภูมิศาสตร์และประวัติศาสตร์
}

model Category {
  id    String         @id @default(cuid())
  name  String         @unique
  slug  String         @unique
  books BookCategory[]
}

model BookCategory {
  bookId     String
  categoryId String
  book       Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([bookId, categoryId])
  @@index([categoryId])
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      Role     @default(READER)
  createdAt DateTime @default(now())

  progress ReadingProgress[]
}

// ตำแหน่งที่อ่านล่าสุดของผู้ใช้ต่อเล่ม (1 แถวต่อคู่ → ไม่โตตามจำนวนครั้งที่อ่าน)
model ReadingProgress {
  userId   String
  bookId   String
  location String // epub CFI หรือเลขหน้า
  percent  Float    @default(0)
  updatedAt DateTime @updatedAt
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book     Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@id([userId, bookId])
}

// ───────────── Events (โตเร็วมาก) ─────────────
model ReadingEvent {
  id         BigInt     @default(autoincrement())
  occurredAt DateTime   @default(now())
  bookId     String
  userId     String?
  visitorId  String?    // id ผู้เยี่ยมชมแบบไม่ระบุตัวตน (ตัวเดียวกับ PageView) → นับจำนวนผู้อ่าน
  sessionId  String     // uuid จาก client ต่อ 1 ครั้งที่เปิดอ่าน
  type       EventType
  percent    Float      @default(0) // 0..1
  deltaSec   Int        @default(0) // วินาทีที่อ่านเพิ่มตั้งแต่ event ก่อนหน้า

  @@id([id, occurredAt]) // partition key ต้องอยู่ใน PK
  @@index([bookId, occurredAt])
  @@index([occurredAt])
}

// การเข้าชมหน้าเว็บ 1 แถว = เปิด 1 หน้า (ไม่เก็บ IP / ข้อมูลส่วนบุคคล)
model PageView {
  id         BigInt     @id @default(autoincrement())
  occurredAt DateTime   @default(now())
  area       SiteArea   // PUBLIC = หน้าบ้าน, ADMIN = หลังบ้าน (/dashboard, /login)
  path       String     // pathname ไม่รวม query string
  visitorId  String     // uuid สุ่มเก็บใน localStorage ของเบราว์เซอร์
  sessionId  String     // uuid ต่อการเข้าใช้ 1 ครั้ง (หมดอายุเมื่อไม่ใช้งาน 30 นาที)
  referrer   String?    // เฉพาะ host ของเว็บต้นทาง และเฉพาะหน้าแรกของ session
  device     DeviceType
  categoryId String?    // เปิดรายการหนังสือของหมวดหมู่ (/books?category=slug) — ไม่ผูก FK เผื่อหมวดถูกลบ

  @@index([occurredAt])
  @@index([area, occurredAt])
  @@index([visitorId, occurredAt])
  @@index([categoryId, occurredAt])
}

enum SiteArea {
  PUBLIC
  ADMIN
}

enum DeviceType {
  MOBILE
  TABLET
  DESKTOP
}

// ───────────── Aggregates (dashboard อ่านจากตรงนี้) ─────────────

model BookStatsDaily {
  bookId        String
  date          DateTime @db.Date
  sessions      Int      @default(0)
  uniqueReaders Int      @default(0) // นับเฉพาะผู้ใช้ที่ล็อกอิน
  totalSec      BigInt   @default(0)
  finished      Int      @default(0)
  book          Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@id([bookId, date])
  @@index([date])
}

model SiteStatsDaily {
  date          DateTime @id @db.Date
  sessions      Int      @default(0)
  uniqueReaders Int      @default(0)
  totalSec      BigInt   @default(0)
}

enum Role {
  READER
  ADMIN
}

enum FileType {
  EPUB
  PDF
}

enum BookStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EventType {
  OPEN
  HEARTBEAT
  CLOSE
  FINISH
}