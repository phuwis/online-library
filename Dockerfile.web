# Build image ของ apps/web (ใช้กับ Render แบบ Docker)
# ก่อน build ต้องมี pnpm-lock.yaml (รัน `pnpm install` ในเครื่องหนึ่งครั้งแล้ว commit)
FROM node:22-alpine AS base
RUN apk add --no-cache libc6-compat openssl
RUN corepack enable
WORKDIR /app

# 1) ตัดเฉพาะ package ที่ web ใช้ (ชื่อ package จริงใน apps/web/package.json คือ online-library-web)
FROM base AS pruner
COPY . .
RUN pnpm dlx turbo@2 prune online-library-web --docker

# 2) ติดตั้ง + build
FROM base AS builder
COPY --from=pruner /app/out/json/ .
COPY --from=pruner /app/out/pnpm-lock.yaml ./pnpm-lock.yaml
# ยังไม่มี schema ในขั้นนี้ จึงข้าม postinstall (prisma generate) ไปก่อน
RUN pnpm install --frozen-lockfile --ignore-scripts
COPY --from=pruner /app/out/full/ .
RUN pnpm --filter @repo/db generate
ENV NEXT_TELEMETRY_DISABLED=1
RUN pnpm --filter online-library-web build

# 3) runtime
FROM base AS runner
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0
WORKDIR /app
COPY --from=builder /app/apps/web/.next/standalone ./
COPY --from=builder /app/apps/web/.next/static ./apps/web/.next/static
# standalone ไม่รวมโฟลเดอร์ public ให้เอง (มาสคอต รูปปกตัวอย่าง ฯลฯ)
COPY --from=builder /app/apps/web/public ./apps/web/public
EXPOSE 3000
CMD ["node", "apps/web/server.js"]